{
  "name": "peridot",
  "version": "0.3.0",
  "description": "Peridot — local AI agent runtime in a terminal GUI. Multi-provider models, six themes.",
  "type": "module",
  "bin": {
    "peridot": "bin/peridot.js"
  },
  "scripts": {
    "build:native": "python scripts/build_native.py",
    "build:themes": "python scripts/build_native.py themes",
    "test": "node --test --test-timeout=60000 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "keywords": [
    "ai",
    "agent",
    "terminal",
    "tui",
    "cli"
  ],
  "license": "MIT"
}
